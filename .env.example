# ========================================
# AgentPay AI — Environment Configuration
# ========================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ---- Database ----
# PostgreSQL (production/docker):
# DATABASE_URL=postgresql://agentpay:agentpay@localhost:5432/agentpay
# SQLite (local dev fallback — used automatically if DATABASE_URL is not set):
DATABASE_URL=sqlite:///./agentpay.db

# ---- Backend ----
SECRET_KEY=change-me-to-a-random-string
BACKEND_PORT=8000

# ---- AI Provider ----
# Options: openai, gemini
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# For Gemini:
# GOOGLE_API_KEY=
# GEMINI_MODEL=gemini-1.5-pro

# ---- Razorpay Test Mode ----
# Get from https://dashboard.razorpay.com/app/keys (TEST MODE)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Application Mode ----
# Set to true to run without real Razorpay/AI credentials
DEMO_MODE=true

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_RAZORPAY_KEY_ID=
